/**
 * Cloudflare Wrangler 設定
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	// 必須與 Cloudflare dashboard 的 Worker 專案名稱一致
	"name": "workflows-starter-template",
	"main": "worker/index.ts",
	"compatibility_date": "2025-10-08",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		// API / webhook / ws 一律交給 Worker，其餘才回靜態頁
		"run_worker_first": ["/api/*", "/webhook/*", "/ws"]
	},
	"observability": {
		"enabled": true
	},
	/**
	 * 排程維護（worker/integrity.ts runMaintenance）：補推送出中的客服訊息、補抓附件、刷新官方帳號設定
	 */
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	/**
	 * Smart Placement：讓 Worker 搬到 D1 旁執行，一次請求做多次查詢時省掉跨區往返
	 */
	"placement": {
		"mode": "smart"
	},
	/**
	 * 非機密設定值。機密（LINE 金鑰、客服台登入 token）請勿寫在這裡：
	 * - 正式：Cloudflare dashboard → 該 Worker → Settings → Variables and Secrets
	 * - 本機（選用）：寫在 .dev.vars（見 .dev.vars.example）
	 */
	"vars": {
		// 客服多久沒回覆就標記「待處理」並推播提醒（分鐘）
		"REPLY_SLA_MINUTES": "10",
		// 使用者加好友時自動回覆的歡迎詞，留空則不送
		"WELCOME_MESSAGE": "您好，感謝加入好友！請直接留言，客服人員會盡快回覆您。",
		// webhook 處理方式：queue = 驗簽後丟進 Queues 立即回 200（需 Workers Paid）；inline = 同步處理
		"WEBHOOK_MODE": "queue"
	},
	/**
	 * Queues：webhook 削峰與重試。免費方案沒有 Queues，bootstrap 建不出來時會自動從部署設定移除並改走 inline
	 */
	"queues": {
		"producers": [
			{
				"binding": "LINE_EVENTS",
				"queue": "cs-console-line-events"
			}
		],
		"consumers": [
			{
				"queue": "cs-console-line-events",
				"max_batch_size": 20,
				"max_batch_timeout": 1,
				"max_retries": 3,
				"dead_letter_queue": "cs-console-line-events-dlq"
			},
			{
				// 重試 3 次仍失敗的事件：記成缺口（含原始事件），不再重試
				"queue": "cs-console-line-events-dlq",
				"max_batch_size": 20,
				"max_batch_timeout": 5,
				"max_retries": 1
			}
		]
	},
	/**
	 * Analytics Engine：處理時間、LINE API 狀態等指標，在 dashboard 用 SQL 查
	 */
	"analytics_engine_datasets": [
		{
			"binding": "METRICS",
			"dataset": "cs_console_metrics"
		}
	],
	/**
	 * D1：對話與訊息的永久儲存
	 * database_id 是資源識別碼（非密鑰），由 scripts/bootstrap.sh 建立資料庫後寫入
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cs-console-db",
			"database_id": "30b6a2d1-57c6-40d6-ba7d-2b4ec8eac62b",
			"migrations_dir": "migrations"
		}
	],
	/**
	 * R2：LINE 傳來的圖片／影片／檔案；bucket 由 scripts/bootstrap.sh 建立
	 */
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "cs-console-media"
		}
	],
	/**
	 * Workflows：逾時未回覆提醒
	 */
	"workflows": [
		{
			"name": "reply-reminder",
			"binding": "REPLY_REMINDER",
			"class_name": "ReplyReminderWorkflow"
		}
	],
	/**
	 * Durable Object：客服台的 WebSocket 連線與即時廣播
	 */
	"durable_objects": {
		"bindings": [
			{
				"name": "INBOX",
				"class_name": "InboxDO"
			}
		]
	},
	/**
	 * Durable Object migrations：只能往後追加，不可改寫已部署過的 tag。
	 * v1 是原始範本的類別（已在正式環境套用過），v2 移除它並建立 InboxDO。
	 */
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["WorkflowStatusDO"]
		},
		{
			"tag": "v2",
			"deleted_classes": ["WorkflowStatusDO"],
			"new_sqlite_classes": ["InboxDO"]
		}
	],
	"upload_source_maps": true
}
